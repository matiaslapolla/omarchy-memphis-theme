#!/bin/bash
# Memphis theme hook. Omarchy runs it after each theme switch with the theme
# slug as $1. On memphis it saves the user's values once and applies the
# Chicago95 GTK theme, cursor, UI font and bottom bar position. On any other
# slug it restores the saved values and deletes the saved state.
#
# It never switches the bar engine. `omarchy bar use` reloads the shell config
# while omarchy-theme-set still applies the theme over IPC, and the new bar
# comes up broken. install.sh makes memphis.bar the engine once instead.

set -euo pipefail

SLUG="${1:-}"
[[ -n $SLUG ]] || exit 0

SCHEMA="org.gnome.desktop.interface"
GTK_THEME="Chicago95"
CURSOR_THEME="Chicago95_Cursor_Black"
FONT_FAMILY_FALLBACK="W95FA"
FONT_SIZE="11"
BAR_POSITION="bottom"
DEFAULT_BAR_POSITION="top"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/memphis"
SAVED="$STATE_DIR/saved.env"
LOCK="$STATE_DIR/theme-set.lock"
# GTK and omarchy-theme-set-glass honour XDG_CONFIG_HOME for gtk.css. Omarchy
# itself reads only $HOME/.config.
GTK4_CSS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/gtk.css"
THEME_NAME_FILE="$HOME/.local/state/omarchy/current/theme.name"
FONT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/memphis"
THEME_DIRS="${MEMPHIS_THEME_DIRS:-$HOME/.local/share/themes:$HOME/.themes:/usr/share/themes}"
ICON_DIRS="${MEMPHIS_ICON_DIRS:-$HOME/.local/share/icons:$HOME/.icons:/usr/share/icons}"
MARK_BEGIN="/* memphis:begin */"
MARK_END="/* memphis:end */"

warn() { echo "memphis theme-set: $*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

# ------------------------------------------------------------------ lookups

find_in_dirs() {
  local dirs="$1" rel="$2" dir
  local IFS=:
  for dir in $dirs; do
    if [[ -e $dir/$rel ]]; then
      printf '%s\n' "$dir/$rel"
      return 0
    fi
  done
  return 1
}

gs_get() { gsettings get "$SCHEMA" "$1" 2>/dev/null; }

# gsettings prints strings as GVariant text ('Yaru'); hyprctl wants the bare name.
gvariant_string() {
  local value="$1"
  if [[ $value == \'*\' ]]; then
    value="${value#\'}"
    value="${value%\'}"
    value="${value//\\\'/\'}"
  fi
  printf '%s\n' "$value"
}

gvariant_int() {
  local value="${1##* }"
  [[ $value =~ ^[0-9]+$ ]] || value=24
  printf '%s\n' "$value"
}

current_bar_position() {
  omarchy bar position 2>/dev/null || echo "$DEFAULT_BAR_POSITION"
}

font_family() {
  local file family=""
  for file in "$FONT_DIR"/*.otf "$FONT_DIR"/*.ttf; do
    [[ -f $file ]] || continue
    if have fc-scan; then
      family=$(fc-scan --format '%{family[0]}' "$file" 2>/dev/null || true)
    fi
    printf '%s\n' "${family:-$FONT_FAMILY_FALLBACK}"
    return 0
  done
  return 1
}

# ------------------------------------------------------------------ saved state

# Values must be one line. The bar position comes from a file the user edits,
# so it is checked before it reaches a command.
valid_line() { [[ $1 != *$'\n'* ]]; }

# Prints the position, or the default when it is not safe to pass to omarchy.
sane_bar_position() {
  local value="$1"
  [[ $value =~ ^(top|bottom|left|right)$ ]] || value="$DEFAULT_BAR_POSITION"
  printf '%s\n' "$value"
}

# True when gtk.css holds nothing outside the Memphis block.
gtk4_css_only_ours() {
  [[ -z $(sed "/^$(sed_regex "$MARK_BEGIN")\$/,/^$(sed_regex "$MARK_END")\$/d" "$GTK4_CSS") ]]
}

# A key whose current value is the Memphis value is left out: Memphis is
# already applied, and the user's own value is lost. restore() skips it.
save_state() {
  [[ ! -e $SAVED ]] || return 0

  local cursor_theme cursor_size font_name bar_position gtk4_existed=0 family
  cursor_theme=$(gs_get cursor-theme || true)
  cursor_size=$(gs_get cursor-size || true)
  font_name=$(gs_get font-name || true)
  bar_position=$(sane_bar_position "$(current_bar_position)")
  family=$(font_family || echo "$FONT_FAMILY_FALLBACK")
  if [[ -e $GTK4_CSS ]] && ! gtk4_css_only_ours; then gtk4_existed=1; fi

  [[ $(gvariant_string "$cursor_theme") != "$CURSOR_THEME" ]] || cursor_theme=""
  case "$(gvariant_string "$font_name")" in
    "$family $FONT_SIZE" | "$FONT_FAMILY_FALLBACK $FONT_SIZE") font_name="" ;;
  esac
  [[ $bar_position != "$BAR_POSITION" ]] || bar_position=""

  local value
  for value in "$cursor_theme" "$cursor_size" "$font_name"; do
    valid_line "$value" || { warn "unexpected multi-line gsettings value; not saving state"; return 1; }
  done

  mkdir -p "$STATE_DIR"
  local tmp="$SAVED.tmp.$$" key
  for key in cursor_theme cursor_size font_name bar_position; do
    [[ -z ${!key} ]] || printf '%s=%s\n' "$key" "${!key}"
  done >"$tmp"
  printf 'gtk4_css_existed=%s\n' "$gtk4_existed" >>"$tmp"
  mv "$tmp" "$SAVED"
}

# A bar_id key from an older version of this hook is ignored.
declare -A STATE=()
load_state() {
  local line key
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *=* ]] || continue
    key="${line%%=*}"
    case "$key" in
      cursor_theme | cursor_size | font_name | bar_position | gtk4_css_existed)
        STATE[$key]="${line#*=}"
        ;;
    esac
  done <"$SAVED"
}

# ------------------------------------------------------------------ gtk-4.0 css

sed_regex() { printf '%s' "$1" | sed 's/[]\/$*.^[]/\\&/g'; }

# sed keeps a missing final newline, so the rest of the file stays byte-identical.
remove_css_block() {
  [[ -f $GTK4_CSS ]] && grep -qxF "$MARK_BEGIN" "$GTK4_CSS" || return 0
  local begin end
  begin=$(sed_regex "$MARK_BEGIN")
  end=$(sed_regex "$MARK_END")
  sed -i --follow-symlinks "/^$begin\$/,/^$end\$/d" "$GTK4_CSS"
}

# The block goes first: GTK ignores an @import that follows other rules.
add_css_block() {
  local import_css="$1"
  mkdir -p "${GTK4_CSS%/*}"
  remove_css_block
  local tmp="$GTK4_CSS.memphis.$$"
  {
    printf '%s\n' "$MARK_BEGIN"
    printf '@import url("file://%s");\n' "$import_css"
    printf '%s\n' "$MARK_END"
    [[ ! -f $GTK4_CSS ]] || cat "$GTK4_CSS"
  } >"$tmp"
  if [[ -f $GTK4_CSS ]]; then
    cat "$tmp" >"$GTK4_CSS"
    rm -f "$tmp"
  else
    mv "$tmp" "$GTK4_CSS"
  fi
}

# ------------------------------------------------------------------ bar

set_bar_position() {
  local position="$1"
  [[ $(current_bar_position) != "$position" ]] || return 0
  omarchy bar position "$position" >/dev/null
}

# ------------------------------------------------------------------ apply

apply_memphis() {
  save_state || warn "could not save the current values; continuing"

  if ! have gsettings; then
    warn "gsettings not found; skipping GTK theme, cursor and font"
  else
    if find_in_dirs "$THEME_DIRS" "$GTK_THEME/index.theme" >/dev/null ||
      find_in_dirs "$THEME_DIRS" "$GTK_THEME/gtk-3.0" >/dev/null; then
      gsettings set "$SCHEMA" gtk-theme "$GTK_THEME" || warn "could not set gtk-theme"
    else
      warn "$GTK_THEME GTK theme not installed; skipping gtk-theme"
    fi

    if find_in_dirs "$ICON_DIRS" "$CURSOR_THEME/cursors" >/dev/null; then
      gsettings set "$SCHEMA" cursor-theme "$CURSOR_THEME" || warn "could not set cursor-theme"
      if have hyprctl; then
        hyprctl setcursor "$CURSOR_THEME" "$(gvariant_int "$(gs_get cursor-size || true)")" >/dev/null ||
          warn "hyprctl setcursor failed"
      fi
    else
      warn "$CURSOR_THEME cursor theme not installed; skipping cursor"
    fi

    local family
    if family=$(font_family); then
      gsettings set "$SCHEMA" font-name "$family $FONT_SIZE" || warn "could not set font-name"
    else
      warn "Memphis font not installed in $FONT_DIR; skipping font-name"
    fi
  fi

  local import_css
  if import_css=$(find_in_dirs "$THEME_DIRS" "$GTK_THEME/gtk-4.0/gtk.css"); then
    add_css_block "$import_css" || warn "could not update $GTK4_CSS"
  else
    warn "$GTK_THEME gtk-4.0/gtk.css not found; skipping GTK4 import"
  fi

  if have omarchy; then
    set_bar_position "$BAR_POSITION" || warn "could not move the bar to $BAR_POSITION"
  else
    warn "omarchy not found; skipping the bar position"
  fi
}

restore() {
  # The block is only ever ours, so it goes even without a saved state.
  remove_css_block || warn "could not clean $GTK4_CSS"
  [[ -f $SAVED ]] || return 0

  load_state
  local ok=1

  if have gsettings; then
    local key
    for key in cursor-theme cursor-size font-name; do
      local value="${STATE[${key//-/_}]:-}"
      [[ -n $value ]] || continue
      gsettings set "$SCHEMA" "$key" "$value" || { warn "could not restore $key"; ok=0; }
    done
    if have hyprctl && [[ -n ${STATE[cursor_theme]:-} ]]; then
      hyprctl setcursor "$(gvariant_string "${STATE[cursor_theme]}")" "$(gvariant_int "${STATE[cursor_size]:-24}")" >/dev/null ||
        warn "hyprctl setcursor failed"
    fi
  else
    warn "gsettings not found; cannot restore cursor and font"
    ok=0
  fi

  if [[ ${STATE[gtk4_css_existed]:-1} == 0 && -f $GTK4_CSS && ! -s $GTK4_CSS ]]; then
    rm -f "$GTK4_CSS"
  fi

  if [[ -n ${STATE[bar_position]:-} ]]; then
    if have omarchy; then
      local bar_position
      bar_position=$(sane_bar_position "${STATE[bar_position]}")
      set_bar_position "$bar_position" || { warn "could not move the bar back to $bar_position"; ok=0; }
    else
      warn "omarchy not found; cannot restore the bar position"
      ok=0
    fi
  fi

  if ((ok)); then
    rm -f "$SAVED"
  else
    warn "kept $SAVED so the next theme switch retries the restore"
  fi
}

# Omarchy runs this hook for every switch, also for one that a newer switch
# replaced while it waited. The lock runs one hook at a time, and theme.name
# names the newest switch, so an older hook leaves the work to the newer one.
mkdir -p "$STATE_DIR"
exec {lock_fd}>"$LOCK"
flock "$lock_fd"
if [[ -f $THEME_NAME_FILE && $(<"$THEME_NAME_FILE") != "$SLUG" ]]; then
  exit 0
fi

if [[ $SLUG == "memphis" ]]; then
  apply_memphis
else
  restore
fi
