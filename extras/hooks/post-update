#!/bin/bash
# Memphis post-update hook. `omarchy update` can change the stock Bar.qml, so
# this rebuilds the memphis.bar plugin from it when the plugin is installed.
# A failed rebuild removes the stale plugin, because its copy of the old
# Bar.qml may not load against the new shell.

set -euo pipefail

# Omarchy reads its config from $HOME/.config and ignores XDG_CONFIG_HOME.
OMARCHY_CONFIG="$HOME/.config/omarchy"
PLUGINS_DIR="$OMARCHY_CONFIG/plugins"
TARGET="$PLUGINS_DIR/memphis.bar"
SHELL_JSON="$OMARCHY_CONFIG/shell.json"
THEME_LINK="$OMARCHY_CONFIG/themes/memphis"

warn() { echo "memphis post-update: $*" >&2; }

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Memphis" "$1" || true
  fi
}

is_memphis_bar() {
  [[ $(jq -r '.id // ""' "$1/manifest.json" 2>/dev/null) == "memphis.bar" ]]
}

drop_stale_bar() {
  local reason="$1"
  if ! is_memphis_bar "$TARGET"; then
    warn "$reason; $TARGET is not ours, leaving it"
    return
  fi
  if [[ -s $SHELL_JSON && $(jq -r '.bar.id // ""' "$SHELL_JSON" 2>/dev/null) == "memphis.bar" ]]; then
    omarchy bar reset >/dev/null || warn "omarchy bar reset failed"
  fi
  rm -rf "$TARGET"
  warn "$reason; removed memphis.bar, the bar is omarchy.bar"
  notify "The bevel bar could not be rebuilt after the update. The bar is back to the stock one."
}

[[ -d $TARGET ]] || exit 0

repo=$(readlink -f "$THEME_LINK" 2>/dev/null || true)
build="$repo/extras/bar-bevel/build.sh"
if [[ -z $repo || ! -f $build ]]; then
  drop_stale_bar "no Memphis repo behind $THEME_LINK"
  exit 0
fi

# build.sh swaps the plugin in atomically, so the shell never sees a half-built
# plugin, and it refuses a memphis.bar that is not its own build.
if ! bash "$build" "$PLUGINS_DIR" >&2; then
  drop_stale_bar "build.sh failed"
fi
